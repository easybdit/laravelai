{
    "name": "easybdit/laraveleasyai",
    "version": "2.4.0",
    "description": "Unified AI chat for Laravel — Ollama, OpenAI, Anthropic (Claude), DeepSeek. One interface, any AI.",
    "keywords": [
        "laravel", "ai", "ollama", "openai", "anthropic",
        "claude", "deepseek", "chatgpt", "llm", "gpt",
        "artificial-intelligence", "chat", "streaming",
        "laravel-package", "php-ai", "machine-learning",
        "rag", "projects", "knowledge-base",
        "ecommerce", "commerce", "chatbot", "vector-search"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Md Murad Hosen",
            "email": "muradbd.info@gmail.com",
            "homepage": "https://www.easyit.com.bd"
        }
    ],
    "funding": [
        {
            "type": "github",
             "url": "https://github.com/sponsors/easybdit"
        },
        {
            "type": "custom",
            "url": "https://easyit.com.bd/donate"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^9.5 || ^10.5 || ^11.0",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpword": "^1.4",
        "phpoffice/phpspreadsheet": "^5.9",
        "phpoffice/phppresentation": "^0.9.0"
    },
    "suggest": {
        "smalot/pdfparser": "Required for PDF file ingestion in Projects (^2.0)",
        "dompdf/dompdf": "Required for exporting a conversation as PDF (^3.0)",
        "phpoffice/phpword": "Required for exporting a conversation as Word (.docx) (^1.4)",
        "phpoffice/phpspreadsheet": "Required for exporting a conversation as Excel (.xlsx) (^5.0)",
        "phpoffice/phppresentation": "Required for exporting a conversation as PowerPoint (.pptx) (^0.9)"
    },
    "autoload": {
        "psr-4": {
            "EasyAI\\LaravelAI\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EasyAI\\LaravelAI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyAI\\LaravelAI\\AIServiceProvider"
            ],
            "aliases": {
                "AI": "EasyAI\\LaravelAI\\Facades\\AI"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
